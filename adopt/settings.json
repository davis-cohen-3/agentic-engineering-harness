{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --path-format=absolute --git-common-dir)/../.claude/hooks/block-default-branch-commit.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --path-format=absolute --git-common-dir)/../.claude/hooks/block-dangerous-bash.sh\""
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --path-format=absolute --git-common-dir)/../.claude/hooks/protect-secrets.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --path-format=absolute --git-common-dir)/../.claude/hooks/flag-comment-bloat.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --path-format=absolute --git-common-dir)/../.claude/hooks/enforce-gate-on-stop.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --path-format=absolute --git-common-dir)/../.claude/hooks/ensure-workspace.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --path-format=absolute --git-common-dir)/../.claude/hooks/spec-session-orient.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --path-format=absolute --git-common-dir)/../.claude/hooks/collab-reminders.sh\""
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --path-format=absolute --git-common-dir)/../.claude/hooks/route-worktree.sh\""
          }
        ]
      }
    ]
  }
}
